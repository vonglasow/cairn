{
  "description": "Say which workspace cairn answers from, hold the focus of the cairn task this session is tied to and let it go, and ask the cairn window for a permission, or the answers to Claude's questions, while one listens.",
  "hooks": {
    "PostToolUse": [
      { "matcher": "^mcp__.*__task_(un)?focus$",
        "hooks": [{ "type": "command", "command": "\"${CLAUDE_PLUGIN_ROOT}\"/hooks/cairn-session.sh" }] }
    ],
    "UserPromptSubmit": [
      { "hooks": [{ "type": "command", "command": "\"${CLAUDE_PLUGIN_ROOT}\"/hooks/cairn-session.sh" }] }
    ],
    "Stop": [
      { "hooks": [{ "type": "command", "command": "\"${CLAUDE_PLUGIN_ROOT}\"/hooks/cairn-session.sh" }] }
    ],
    "SessionStart": [
      { "hooks": [{ "type": "command", "command": "\"${CLAUDE_PLUGIN_ROOT}\"/hooks/cairn-session.sh" }] }
    ],
    "PreToolUse": [
      { "matcher": "AskUserQuestion",
        "hooks": [{ "type": "command", "command": "\"${CLAUDE_PLUGIN_ROOT}\"/hooks/cairn-permission.sh", "timeout": 86400 }] }
    ],
    "PermissionRequest": [
      { "hooks": [{ "type": "command", "command": "\"${CLAUDE_PLUGIN_ROOT}\"/hooks/cairn-permission.sh", "timeout": 86400 }] }
    ],
    "SessionEnd": [
      { "hooks": [{ "type": "command", "command": "\"${CLAUDE_PLUGIN_ROOT}\"/hooks/cairn-session.sh" }] }
    ]
  }
}
