{
  "description": "Hold the focus of the cairn task this session is tied to, and let it go.",
  "hooks": {
    "PostToolUse": [
      { "matcher": "^mcp__.*__task_(un)?focus$",
        "hooks": [{ "type": "command", "command": "\"${CLAUDE_PLUGIN_ROOT}\"/hooks/cairn-session.sh" }] }
    ],
    "UserPromptSubmit": [
      { "hooks": [{ "type": "command", "command": "\"${CLAUDE_PLUGIN_ROOT}\"/hooks/cairn-session.sh" }] }
    ],
    "Stop": [
      { "hooks": [{ "type": "command", "command": "\"${CLAUDE_PLUGIN_ROOT}\"/hooks/cairn-session.sh" }] }
    ],
    "SessionEnd": [
      { "hooks": [{ "type": "command", "command": "\"${CLAUDE_PLUGIN_ROOT}\"/hooks/cairn-session.sh" }] }
    ]
  }
}
