
# coverage artifacts
coverage.out

# build output
/bin/
/dist/
/mutation-report/

# what make trace records on a machine the window misbehaves on
/traces/

# red receipts: proof a test failed, not history worth keeping
/.claude/red/

# the store cairn's own development is planned in, and its notes: one
# person's board, not the project's
/.cairn/

# personal overrides, not the team's
/.claude/settings.local.json

# what must never be committed by accident: a store or its backups pointed
# into the tree by CAIRN_STORE, an environment file, a key — the secrets
# packs semgrep runs at commit catch what slips past these
*.db
# a database a scenario reads as somebody else's, kept on purpose
!internal/cli/testdata/*.db
*.db-wal
*.db-shm
*.db.arriving
.env
.env.*
*.pem
*.key
.package.*/
